"""
app.py
──────────────────────────────────────────────────────────────
Streamlit UI 入口。

架構：
  app.py           │ Streamlit UI
  gemini_vision.py │ Gemini 電路圖辨識（只在「非測試模式」才會被呼叫）
  circuit_parser.py│ JSON / 文字 互轉
  circuit_analysis │ 電路分析（一般電阻）
  voltage_divider  │ 分壓計算
  test_data.py     │ 測試用電路資料（測試模式下取代 Gemini）

側邊欄有一個「🧪 使用測試資料」開關：打開後，Step 2 的元件清單
會直接從 test_data.py 產生，完全不會呼叫 Gemini API，
可以放心重複按「重新啟動圖片分析」/「開始計算」除錯 UI 跟分壓邏輯，
不會多花任何 API 額度。要驗證真正的辨識效果時再關掉即可。
"""
import os
from PIL import Image
import streamlit as st

import circuit_parser
import circuit_analysis
import test_data

st.set_page_config(layout="wide", page_title="Derating")
st.title("Derating Check")

DERATING_TARGET = 0.80

# ==============================================================================
#  側邊欄：測試模式開關
# ==============================================================================
st.sidebar.header("⚙️ 開發 / 測試設定")
use_test_data = st.sidebar.checkbox(
    "🧪 使用測試資料（不呼叫 Gemini）",
    value=False,
    help="開啟後 Step 2 的元件清單會直接套用 test_data.py 裡的假資料，"
         "不會真的呼叫 Gemini API，適合反覆測試分壓邏輯或調整 UI 時使用。",
)

selected_test_circuit = None
if use_test_data:
    selected_test_circuit = st.sidebar.selectbox(
        "選擇測試電路",
        options=test_data.get_test_circuit_names(),
    )
    st.sidebar.caption("目前使用假資料，Step 1 上傳圖片僅供預覽，不會送出給 Gemini。")

if "realtime_user_text" not in st.session_state:
    st.session_state.realtime_user_text = ""

col1, col2 = st.columns(2)

# ==============================================================================
#  Step 1 + Step 2：上傳圖片 → 產生元件清單
# ==============================================================================
with col1:
    st.header("Step 1：上傳電路圖")
    uploaded_file = st.file_uploader("請上傳或拖曳圖片...", type=["png", "jpg", "jpeg"])

    # 測試模式下就算沒上傳圖片，也可以直接用假資料跑後面的流程
    ready_for_step2 = uploaded_file is not None or use_test_data

    if uploaded_file:
        image = Image.open(uploaded_file)
        st.image(image, caption="已讀取電路圖", use_container_width=True)
    else:
        image = None

    if ready_for_step2:
        st.header("Step 2：辨識結果")

        rerun_label = "🧪 重新套用測試資料" if use_test_data else "🚀 重新啟動圖片分析"
        should_generate = (
            "clean_ocr_output" not in st.session_state
            or st.button(rerun_label)
        )

        if should_generate:
            if use_test_data:
                # ------------------------------------------------------------
                # 測試模式：直接讀 test_data.py，完全不呼叫 Gemini
                # ------------------------------------------------------------
                parsed_data = test_data.get_test_circuit(selected_test_circuit)
                result_text = circuit_parser.json_to_text_lines(parsed_data)
                st.session_state.clean_ocr_output = result_text
                st.session_state.realtime_user_text = result_text
                st.caption(f"（測試資料來源：{selected_test_circuit}，未呼叫 Gemini API）")
            else:
                # ------------------------------------------------------------
                # 正常模式：真的呼叫 Gemini Vision
                # ------------------------------------------------------------
                import gemini_vision  # 延後匯入：測試模式完全不會載入這個模組

                with st.spinner("🧠 正在進行線路推理中..."):
                    parsed_data, error = gemini_vision.call_gemini_vision(image)
                    if error:
                        result_text = error
                    else:
                        result_text = circuit_parser.json_to_text_lines(parsed_data)
                    st.session_state.clean_ocr_output = result_text
                    st.session_state.realtime_user_text = result_text

        # 讓使用者可以即時修改與刪除 (綁定 key 機制)
        st.text_area(
            "元件與電壓清單 (若有小誤差可手動修改)：",
            value=st.session_state.realtime_user_text,
            height=250,
            key="realtime_user_text",  # 加上固定 key，由 st.session_state 主導管理
        )
        st.caption(
            "分壓電路格式：在兩顆串聯電阻尾端分別標示 _TOP（接電源）/ _BOT（接地）"
        )

# ==============================================================================
#  Step 3：Derating 分析
# ==============================================================================
with col2:
    st.header("Step 3：Derating 分析")
    can_run_step3 = (uploaded_file is not None or use_test_data)

    if can_run_step3 and st.button("開始計算Derating判定", type="primary"):
        with st.spinner("正在讀取並執行計算..."):
            try:
                # 從安全初始化後的狀態中提取即時文字
                current_text = st.session_state.realtime_user_text

                # 呼叫計算核心（一般電阻 + 分壓電路都在這裡整合）
                report_card = circuit_analysis.run_derating_analysis(current_text, DERATING_TARGET)

                st.success("✅ 計算完成！")
                st.write("---")

                if not report_card:
                    st.warning("⚠️ 文字框內無有效的電阻元件格式，請確認格式（如：HR1=10K_1/16W_3.3V）。")

                # 尋找所有算好的結果
                for component in report_card:
                    st.subheader(f"🔍 元件： {component['name']}")

                    # 分壓配對不完整時的提醒
                    if component.get('divider_warning'):
                        st.warning(f"⚠️ {component['divider_warning']}")

                    is_divider = component.get('is_divider', False)
                    this_r_voltage = component.get('voltage_used', 3.3)
                    i_divider = component.get('divider_current', 0.0)

                    if is_divider:
                        role_label = "上橋 TOP（接電源）" if component.get('divider_role') == 'TOP' else "下橋 BOT（接地）"
                        vin = component.get('divider_vin', this_r_voltage)
                        vout = component.get('divider_vout', 0.0)
                        st.info(
                            f"分壓： {role_label}\n\n"
                            f"Vin： `{vin:.2f} V` ｜ Vout（分壓節點）： `{vout:.2f} V` ｜ "
                        )
                    else:
                        st.info(f"工作電壓： `{this_r_voltage:.1f} V`")

                    # 💡 提取前端即將用來顯示
                    r_val = float(component.get('r_value', 0.0))
                    p_max = float(component.get('p_max', 0.0625))
                    p_act = float(component.get('p_act', 0.0))

                    formula_label = "I² × R / Pmax" if is_divider else "V² / R / Pmax"

                    # 檢查是否為跳線，或者分母是否包含任何0
                    if component.get('is_jumper', False) or r_val <= 0 or p_max <= 0:
                        # 只要發現任何一個分母是 0，或者標記為跳線，100% 封鎖原本的算式！
                        st.markdown(f"* **阻值 (R)**： `0.0 Ω` (jump)")
                        st.markdown(f"* **量測工作功耗 (Pact)**： `0.000000 W` ")
                        st.markdown(f"* **額定最大功率 (PMAX)**： `{p_max if p_max > 0 else 0.0625:.4f} W` ")

                        st.markdown(f"* **Pact/Pmax計算 ({formula_label})**：")
                        # 全部用純文字印出
                        if is_divider:
                            st.code(f"({i_divider * 1000:.3f}mA)² × 0.002Ω (0歐姆) = 0.0000")
                        else:
                            st.code(f"({this_r_voltage:.1f}V)² / 0.002Ω (0歐姆) = 0.0000")
                        st.markdown(f"* **Pact/Pmax**： `0.0%` (降額標準: {DERATING_TARGET*100}%)")
                        st.success(f"🟢 **PASS (0歐姆跳線)**")

                    else:
                        # 只有在阻值大於0、且最大功率大於0的絕對安全狀態下，才放行跑正常電阻顯示
                        st.markdown(f"* **電阻值 (R)**： `{r_val:.1f} Ω` ")
                        st.markdown(f"* **量測工作功耗 (Pact)**： `{p_act:.6f} W` ")
                        st.markdown(f"* **額定最大功率 (Pmax)**： `{p_max:.4f} W` ")

                        st.markdown(f"* **Pact/Pmax計算 ({formula_label})**：")

                        # 在執行字串格式化列印前，做前端最後的雙重除法安全檢查
                        safe_stress_ratio = component.get('stress_ratio', 0.0)

                        if is_divider:
                            st.code(f"({i_divider * 1000:.3f}mA)² × {r_val:.0f}Ω / {p_max:.4f}W = {safe_stress_ratio:.4f}")
                        else:
                            st.code(f"({this_r_voltage:.1f}V)² / {r_val:.0f}Ω / {p_max:.4f}W = {safe_stress_ratio:.4f}")
                        st.markdown(f"* **Pact/Pmax**： `{safe_stress_ratio*100:.8f}%` (Derating標準: {DERATING_TARGET*100}%)")

                        if component.get('is_pass', False):
                            st.success(f"🟢 **PASS (符合Derating標準)**")
                        else:
                            st.error(f"❌ **FAIL (未通過Derating標準)**")

                    st.write("---")

            except Exception as e:
                # 萬一有其他未想到的除法死角，把當機壓制住，改成印出貼心提示
                st.error(f"計算過程中有元件阻值或功率異常（含有 0 值），已被系統安全熔斷隔離。")
                st.code(f"錯誤報告: {e}")
